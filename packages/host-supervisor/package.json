{
  "name": "@electron-stagewright/host-supervisor",
  "version": "0.1.0",
  "description": "Supervisor for one stateful host off the Electron main thread: a closed operation list, lazy start, drain on stop, per-call timeout and AbortSignal, a pending limit, and bounded restart, over worker_threads or utilityProcess.",
  "type": "module",
  "license": "MIT",
  "author": "johnny4young <johnny.iv.young@gmail.com>",
  "homepage": "https://electron-stagewright.github.io/electron-stagewright/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/electron-stagewright/electron-stagewright.git",
    "directory": "packages/host-supervisor"
  },
  "bugs": {
    "url": "https://github.com/electron-stagewright/electron-stagewright/issues"
  },
  "keywords": [
    "electron",
    "utility-process",
    "worker-threads",
    "supervisor",
    "rpc",
    "performance"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./utility": {
      "types": "./dist/utility.d.ts",
      "import": "./dist/utility.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "electron": ">=42.0.0"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    }
  },
  "devDependencies": {
    "electron": "^42.11.10"
  }
}
