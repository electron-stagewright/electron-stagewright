{
  "name": "@electron-stagewright/core",
  "mcpName": "io.github.electron-stagewright/core",
  "version": "0.5.0",
  "description": "Agentic UX testing for real Electron apps: launch, inspect, interact, assert, and capture evidence through MCP.",
  "type": "module",
  "license": "MIT",
  "author": "johnny4young <johnny.iv.young@gmail.com>",
  "homepage": "https://electron-stagewright.github.io/electron-stagewright/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/electron-stagewright/electron-stagewright.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/electron-stagewright/electron-stagewright/issues"
  },
  "keywords": [
    "electron",
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "claude",
    "claude-code",
    "cursor",
    "testing",
    "automation",
    "e2e",
    "playwright",
    "stagewright",
    "agentic-ux-testing",
    "electron-testing",
    "desktop-testing",
    "accessibility",
    "llm"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "electron-stagewright": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugin-sdk": {
      "types": "./dist/plugin-sdk/index.d.ts",
      "import": "./dist/plugin-sdk/index.js"
    }
  },
  "scripts": {
    "build": "pnpm build:resources && tsc -p tsconfig.json && pnpm build:renderer",
    "build:resources": "node scripts/build-agent-resources.mjs",
    "check:resources": "node scripts/build-agent-resources.mjs --check",
    "build:renderer": "node scripts/build-renderer-bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@electron/fuses": "^2.1.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "acorn": "^8.17.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron-stagewright/demo": "workspace:*",
    "electron": "^42.3.0",
    "esbuild": "^0.28.1",
    "highlight.js": "^11.11.1",
    "jsdom": "^29.1.1",
    "marked": "^18.0.6",
    "marked-highlight": "^2.2.4",
    "playwright": "^1.61.1"
  },
  "peerDependencies": {
    "electron": ">=12.2.0",
    "playwright": ">=1.49.0"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    },
    "playwright": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
